{
  "name": "ambient-art-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Turn real-time data streams into live WebGL ambient art.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:web": "pnpm --filter @ambient/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "tsx packages/sdk/examples/demo.ts",
    "dev:engine": "tsx packages/engine/examples/demo.ts",
    "dev:web": "pnpm --filter @ambient/web dev",
    "clean": "pnpm -r run clean",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:visual": "node scripts/visual-check.mjs",
    "test:app": "node scripts/app-check.mjs"
  },
  "devDependencies": {
    "@ambient/sdk": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "playwright": "^1.63.0",
    "rxjs": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
