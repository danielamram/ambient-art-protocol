{
  "name": "@ambient/sources",
  "version": "0.0.0",
  "description": "Built-in data source plugins for Ambient Art Protocol. Phase 4.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ambient/sdk": "workspace:*"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
