{
  "name": "@ambient/sdk",
  "version": "0.0.0",
  "description": "Core SDK for Ambient Art Protocol: the VisualSignal protocol, DataSignalBus, and createSource() for building data source plugins.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
